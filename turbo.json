{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/*"],
      "env": ["DATABASE_URL"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "cache": true
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "format" : {
      "cache": true
    },
    "start": {
      "dependsOn": ["^lint", "^format"]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true

    },
     "db:generate": {
      "cache": true
    },
    "db:studio": {
      "cache": false
    },
    "db:migrate": {
      "cache": true,
      "persistent": true 
    },
    "db:deploy": {
      "cache": false
    }
  }
}
